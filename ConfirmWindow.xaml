<Window x:Class="DiskMap.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.Confirm.Title}"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13"/>

        <TextBlock Grid.Row="1"
                   Text="{DynamicResource L.Confirm.Footer}"
                   Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="{DynamicResource L.Confirm.Cancel}" MinWidth="96"
                    IsCancel="True" IsDefault="True" Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton" Content="{DynamicResource L.Confirm.Continue}" MinWidth="116" Margin="8,0,0,0"
                    Style="{StaticResource DangerButton}" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
